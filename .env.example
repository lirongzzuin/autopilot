# ─── Supabase ───
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # 서버 전용

# ─── 플랫폼 AI 키 (Platform 모드 / 폴백용) ───
PLATFORM_OPENAI_API_KEY=your-openai-key
PLATFORM_ANTHROPIC_API_KEY=your-anthropic-key
PLATFORM_GOOGLE_AI_API_KEY=your-google-ai-key

# ─── 암호화 (BYOK 키·빌링키) — 64자리 hex: openssl rand -hex 32 ───
ENCRYPTION_KEY=

# ─── Upstash Redis (레이트리밋·AI 응답 캐시) ───
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ─── 토스페이먼츠 (빌링 정기결제) ───
NEXT_PUBLIC_TOSS_PAYMENTS_CLIENT_KEY=test_ck_your-client-key
TOSS_PAYMENTS_SECRET_KEY=test_sk_your-secret-key
TOSS_PAYMENTS_WEBHOOK_SECRET=your-webhook-secret

# ─── Resend (다이제스트·결제 알림 메일) ───
RESEND_API_KEY=your-resend-key

# ─── Cron 인증 — openssl rand -hex 32 ───
CRON_SECRET=

# ─── 앱 URL ───
NEXT_PUBLIC_APP_URL=http://localhost:3000
